{
  "name": "Despesa",
  "type": "object",
  "properties": {
    "valor": {
      "type": "number",
      "description": "Valor da despesa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da despesa"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Alimenta\u00e7\u00e3o",
        "Sa\u00fade",
        "Educa\u00e7\u00e3o",
        "Transporte",
        "Lazer",
        "Roupas",
        "Casa",
        "Outros"
      ],
      "description": "Categoria da despesa"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da despesa"
    },
    "filho_id": {
      "type": "string",
      "description": "ID do filho vinculado (opcional)"
    },
    "filho_nome": {
      "type": "string",
      "description": "Nome do filho vinculado (opcional)"
    }
  },
  "required": [
    "valor",
    "descricao",
    "data"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}