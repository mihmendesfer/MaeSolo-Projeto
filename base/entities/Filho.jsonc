{
  "name": "Filho",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do filho"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    }
  },
  "required": [
    "nome",
    "data_nascimento"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}