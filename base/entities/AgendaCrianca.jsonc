{
  "name": "AgendaCrianca",
  "type": "object",
  "properties": {
    "filho_id": {
      "type": "string",
      "description": "ID do filho vinculado"
    },
    "filho_nome": {
      "type": "string",
      "description": "Nome do filho (para exibi\u00e7\u00e3o r\u00e1pida)"
    },
    "data_horario": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hor\u00e1rio do compromisso"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do compromisso"
    }
  },
  "required": [
    "filho_id",
    "filho_nome",
    "data_horario",
    "descricao"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}